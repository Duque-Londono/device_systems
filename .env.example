# Variables de entorno de device_systems (Guía 11 - Seguridad)
# Copia este archivo como .env y ajusta los valores. NUNCA subas el .env real.

# Clave secreta para firmar los tokens JWT. Genera una robusta, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambia-esta-clave-en-produccion-device-systems-2026

# Algoritmo de firma del JWT.
ALGORITHM=HS256

# Minutos de validez del token de acceso.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Orígenes (frontend) autorizados para CORS, separados por comas.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
